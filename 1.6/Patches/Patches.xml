<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/IncidentDef[defName="RaidEnemy" or defName="TraderCaravanArrival" or defName="VisitorGroup"]</xpath>
    <value>
      <li Class="SurveillanceShift.MuteArrivalExtension" />
    </value>
  </Operation>

  <Operation Class="PatchOperationInsert">
    <xpath>Defs/ThinkTreeDef[defName="Animal"]/thinkRoot/subNodes/li[@Class="ThinkNode_ConditionalOfPlayerFaction"]/subNodes/li[tagToGive="TrainedAnimalBehavior"]/subNodes/li[trainable="Obedience"]</xpath>
    <value>
      <li Class="SurveillanceShift.ThinkNode_ConditionalAnimalPatrolling" MayRequire="Thek.GuardingP">
        <subNodes>
          <li Class="SurveillanceShift.JobGiver_AnimalPatrol" />
        </subNodes>
      </li>
    </value>
  </Operation>

  <Operation Class="PatchOperationInsert">
    <xpath>Defs/ThinkTreeDef[defName="HumanlikeConstant"]/thinkRoot/subNodes/li[@Class="ThinkNode_ConditionalCanDoConstantThinkTreeJobNow"]/subNodes/li[@Class="ThinkNode_ConditionalIsCrawling"]</xpath>
    <value>
      <li Class="SurveillanceShift.JobGiver_ColonistThreatReaction" />
    </value>
  </Operation>

  <Operation Class="PatchOperationInsert">
    <xpath>Defs/ThinkTreeDef[defName="AnimalConstant"]/thinkRoot/subNodes/li[@Class="ThinkNode_ConditionalCanDoConstantThinkTreeJobNow"]/subNodes/li[@Class="ThinkNode_Subtree"]</xpath>
    <value>
      <li Class="SurveillanceShift.JobGiver_AnimalThreatReaction" />
    </value>
  </Operation>
</Patch>
