<Defs>

	<OrderedTakeGroupDef>
		<defName>SS_RemoteSurveillanceDevice</defName>
		<label>remote surveillance tablet</label>
		<max>1</max>
	</OrderedTakeGroupDef>

	<ThingDef ParentName="ResourceBase">
		<defName>SS_RemoteSurveillanceDevice</defName>
		<label>remote surveillance tablet</label>
		<researchPrerequisites>
			<li>SS_RemoteSurveillance</li>
		</researchPrerequisites>
		<description>A small touchscreen data streaming tablet with wireless functionality. Requires a linked router to permit network surveillance.</description>
		<graphicData>
			<texPath>Things/Item/Special/RemoteSurveillanceDevice</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<WorkToMake>6000</WorkToMake>
			<MarketValue>1200</MarketValue>
			<MaxHitPoints>60</MaxHitPoints>
			<Mass>0.5</Mass>
			<Flammability>0.5</Flammability>
			<DeteriorationRate>6</DeteriorationRate>
		</statBases>
		<costList>
			<Steel>40</Steel>
			<ComponentIndustrial>4</ComponentIndustrial>
			<ComponentSpacer>1</ComponentSpacer>
		</costList>
		<recipeMaker>
			<researchPrerequisite>SS_RemoteSurveillance</researchPrerequisite>
			<recipeUsers>
				<li>FabricationBench</li>
			</recipeUsers>
			<displayPriority>313</displayPriority>
		</recipeMaker>
		<tickerType>Rare</tickerType>
		<techLevel>Industrial</techLevel>
		<stackLimit>1</stackLimit>
		<soundInteract>Standard_Drop</soundInteract>
		<soundDrop>Standard_Drop</soundDrop>
		<thingCategories>
			<li>Manufactured</li>
		</thingCategories>
		<orderedTakeGroup>SS_RemoteSurveillanceDevice</orderedTakeGroup>
		<comps>
			<li Class="SurveillanceShift.CompProperties_RemoteSurveillanceDevice" />
		</comps>
		<tradeability>Sellable</tradeability>
	</ThingDef>

