<?xml version="1.0" encoding="utf-8" ?>

<Defs>

	<ThingDef ParentName="BuildingBase">
		<defName>SS_WallCamera</defName>
		<label>wall camera</label>
		<description>A surveillance camera mounted on a wall.</description>
		<rotatable>true</rotatable>
		<thingClass>SurveillanceShift.Building_WallCamera</thingClass>
		<category>Building</category>
		<thingCategories>
			<li>BuildingsFurniture</li>
		</thingCategories>
		<minifiedDef>MinifiedThing</minifiedDef>
		<overrideMinifiedRot>North</overrideMinifiedRot>
		<minifiedDrawOffset>(0, 0, 0.2)</minifiedDrawOffset>
		<defaultPlacingRot>North</defaultPlacingRot>
		<graphicData>
			<texPath>Things/Building/Cameras/WallCamera</texPath>
			<drawSize>(1.1,1.1)</drawSize>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawOffsetEast>(0.5,0,0)</drawOffsetEast>
			<drawOffsetNorth>(0,0,0.7)</drawOffsetNorth>
			<drawOffsetWest>(-0.5,0,0)</drawOffsetWest>
			<drawOffsetSouth>(0,0,-0.6)</drawOffsetSouth>
			<damageData>
				<enabled>false</enabled>
			</damageData>
		</graphicData>
		<building>
			<isEdifice>false</isEdifice>
			<isAttachment>true</isAttachment>
			<ai_chillDestination>false</ai_chillDestination>
		</building>
		<placeWorkers>
			<li>Placeworker_AttachedToWall</li>
		</placeWorkers>
		<altitudeLayer>BuildingOnTop</altitudeLayer>
		<terrainAffordanceNeeded IsNull="True" />
		<pathCost>0</pathCost>
		<passability>Standable</passability>
		<fillPercent>0.75</fillPercent>
		<canOverlapZones>false</canOverlapZones>
		<castEdgeShadows>false</castEdgeShadows>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<WorkToBuild>500</WorkToBuild>
			<Flammability>0.5</Flammability>
			<Mass>5</Mass>
		</statBases>
		<size>(1,1)</size>
		<costList>
			<Steel>40</Steel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>40</basePowerConsumption>
			</li>
			<li Class="CompProperties_Flickable" />
		</comps>
		<selectable>true</selectable>
		<neverMultiSelect>false</neverMultiSelect>
		<tickerType>Normal</tickerType>
		<designationCategory>Security</designationCategory>
		<uiOrder>2011</uiOrder>
		<constructEffect>ConstructMetal</constructEffect>
	</ThingDef>

	<ThingDef ParentName="BuildingBase">
		<defName>SS_CameraTower</defName>
		<label>camera tower</label>
		<description>camera tower</description>
		<thingClass>SurveillanceShift.Building_Camera</thingClass>
		<category>Building</category>
		<thingCategories>
			<li>BuildingsFurniture</li>
		</thingCategories>
		<minifiedDef>MinifiedThing</minifiedDef>
		<graphicData>
			<texPath>Things/Building/Cameras/PoleMountedCamera</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.4,2.4)</drawSize>
			<drawOffset>(0,0,0.5)</drawOffset>
			<shadowData>
				<volume>(0.3, 0.6, 0.3)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<building>
			<ai_chillDestination>false</ai_chillDestination>
		</building>
		<pathCost>14</pathCost>
		<passability>PassThroughOnly</passability>
		<canOverlapZones>false</canOverlapZones>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<WorkToBuild>500</WorkToBuild>
			<Flammability>0.5</Flammability>
			<Mass>5</Mass>
		</statBases>
		<size>(1,1)</size>
		<costList>
			<Steel>40</Steel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<selectable>true</selectable>
		<neverMultiSelect>false</neverMultiSelect>
		<tickerType>Normal</tickerType>
		<designationCategory>Security</designationCategory>
		<uiOrder>2012</uiOrder>
		<comps>
			<li Class="VEF.Buildings.CompProperties_RandomBuildingGraphic">
				<randomGraphics>
					<li>Things/Building/Cameras/PoleMountedCamera</li>
					<li>Things/Building/Cameras/PoleMountedCameraAlt</li>
				</randomGraphics>
				<optionalNames>
					<li>Camera tower</li>
					<li>Alternate</li>
				</optionalNames>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>50</basePowerConsumption>
			</li>
			<li Class="CompProperties_Flickable" />
		</comps>
		<constructEffect>ConstructMetal</constructEffect>
	</ThingDef>

	<ThingDef ParentName="BenchBase">
		<defName>SS_SurveillanceStation</defName>
		<label>surveillance station</label>
		<description>surveillance station</description>
		<thingClass>SurveillanceShift.Building_SurveillanceStation</thingClass>
		<category>Building</category>
		<thingCategories>
			<li>BuildingsMisc</li>
		</thingCategories>
		<minifiedDef>MinifiedThing</minifiedDef>
		<graphicData>
			<texPath>Things/Building/SurveillanceStation/SurveillanceStation</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(6.4,3.4)</drawSize>
		</graphicData>
		<castEdgeShadows>true</castEdgeShadows>
		<staticSunShadowHeight>0.2</staticSunShadowHeight>
		<building>
			<ai_chillDestination>false</ai_chillDestination>
		</building>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<passability>PassThroughOnly</passability>
		<pathCost>50</pathCost>
		<fillPercent>0.4</fillPercent>
		<hasInteractionCell>true</hasInteractionCell>
		<canOverlapZones>false</canOverlapZones>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<WorkToBuild>500</WorkToBuild>
			<Flammability>0.5</Flammability>
			<Mass>5</Mass>
		</statBases>
		<size>(5,2)</size>
		<costList>
			<Steel>200</Steel>
			<ComponentIndustrial>10</ComponentIndustrial>
		</costList>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>350</basePowerConsumption>
				<shortCircuitInRain>true</shortCircuitInRain>
			</li>
			<li Class="CompProperties_Flickable" />
			<li Class="CompProperties_Breakdownable" />
		</comps>
		<selectable>true</selectable>
		<neverMultiSelect>false</neverMultiSelect>
		<tickerType>Normal</tickerType>
		<designationCategory>Security</designationCategory>
		<uiOrder>2013</uiOrder>
		<constructEffect>ConstructMetal</constructEffect>
	</ThingDef>

	<ThingDef ParentName="BuildingBase">
		<defName>SS_DominionTower</defName>
		<label>dominion tower</label>
		<description>text.todo.</description>
		<thingClass>SurveillanceShift.Building_DominionTower</thingClass>
		<category>Building</category>
		<size>(4,4)</size>
		<rotatable>false</rotatable>
		<graphicData>
			<texPath>Things/Building/DominionTower/DominionTower</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(6,12)</drawSize>
			<drawOffset>(0,0,4)</drawOffset>
		</graphicData>
		<altitudeLayer>Building</altitudeLayer>
		<passability>Impassable</passability>
		<fillPercent>1</fillPercent>
		<pathCost>0</pathCost>
		<statBases>
			<MaxHitPoints>600</MaxHitPoints>
			<WorkToBuild>3500</WorkToBuild>
			<Flammability>0.3</Flammability>
		</statBases>
		<costList>
			<Steel>150</Steel>
			<ComponentIndustrial>5</ComponentIndustrial>
		</costList>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>120</basePowerConsumption>
			</li>
			<li Class="CompProperties_Flickable" />
			<li Class="VEF.Buildings.CompProperties_RandomBuildingGraphic">
				<randomGraphics>
					<li>Things/Building/DominionTower/DominionTower</li>
					<li>Things/Building/DominionTower/DominionTower2</li>
					<li>Things/Building/DominionTower/DominionTower3</li>
				</randomGraphics>
				<optionalNames>
					<li>Dominion tower 1</li>
					<li>Dominion tower 2</li>
					<li>Dominion tower 3</li>
				</optionalNames>
			</li>
		</comps>
		<selectable>true</selectable>
		<tickerType>Normal</tickerType>
		<designationCategory>Security</designationCategory>
		<uiOrder>2014</uiOrder>
		<constructEffect>ConstructMetal</constructEffect>
	</ThingDef>

</Defs>
