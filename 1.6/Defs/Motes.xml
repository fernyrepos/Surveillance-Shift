<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef Name="SS_PingBase" ParentName="MoteBase" Abstract="True">
    <thingClass>SurveillanceShift.Mote_Ping</thingClass>
    <graphicData>
      <texPath>Things/Mote/Transparent</texPath>
      <shaderType>MoteGlow</shaderType>
      <drawSize>(1, 1)</drawSize>
    </graphicData>
    <altitudeLayer>MetaOverlays</altitudeLayer>
    <mote>
      <fadeInTime>0.05</fadeInTime>
      <solidTime>999999</solidTime>
      <fadeOutTime>0.1</fadeOutTime>
    </mote>
  </ThingDef>

  <ThingDef ParentName="SS_PingBase">
    <defName>SS_Mote_PingHostile</defName>
    <graphicData>
      <color>(0.95, 0.15, 0.15, 0.85)</color>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="SS_PingBase">
    <defName>SS_Mote_PingFriendly</defName>
    <graphicData>
      <color>(0.2, 0.6, 0.95, 0.85)</color>
    </graphicData>
  </ThingDef>

  <ThingDef Name="SS_ObservationMoteBase" ParentName="MoteBase" Abstract="True">
    <thingClass>SurveillanceShift.Mote_ObservationDevice</thingClass>
    <drawOffscreen>true</drawOffscreen>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <mote>
      <fadeInTime>0.1</fadeInTime>
      <solidTime>999999</solidTime>
      <fadeOutTime>0.1</fadeOutTime>
    </mote>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="SS_ObservationMoteBase">
    <defName>SS_Mote_Spyglass</defName>
    <graphicData>
      <texPath>Things/Mote/Spyglass/Spyglass</texPath>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="SS_ObservationMoteBase">
    <defName>SS_Mote_Binoculars</defName>
    <graphicData>
      <texPath>Things/Mote/Binoculars/Binoculars</texPath>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="SS_ObservationMoteBase">
    <defName>SS_Mote_RemoteSurveillanceDevice</defName>
    <thingClass>SurveillanceShift.Mote_RemoteSurveillanceDevice</thingClass>
    <graphicData>
      <texPath>Things/Mote/RemoteSurveillanceDevice/RemoteSurveillanceDevice</texPath>
    </graphicData>
  </ThingDef>
</Defs>
