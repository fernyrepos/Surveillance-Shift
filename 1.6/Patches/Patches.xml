<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/IncidentDef[defName="RaidEnemy" or defName="TraderCaravanArrival" or defName="VisitorGroup"]</xpath>
    <value>
      <li Class="SurveillanceShift.MuteArrivalExtension" />
    </value>
  </Operation>

  <Operation Class="PatchOperationInsert">
    <xpath>Defs/ThinkTreeDef[defName="Mechanoid"]/thinkRoot/subNodes/li[@Class="ThinkNode_ConditionalPlayerControlledMech"][1]</xpath>
    <value>
      <li Class="SurveillanceShift.ThinkNode_ConditionalGuardDuty">
        <subNodes>
          <li Class="ThinkNode_Tagger">
            <tagToGive>Misc</tagToGive>
            <subNodes>
              <li Class="SurveillanceShift.JobGiver_GuardEngage" />
              <li Class="SurveillanceShift.JobGiver_GuardDuty" />
            </subNodes>
          </li>
        </subNodes>
      </li>
    </value>
  </Operation>

  <Operation Class="PatchOperationInsert">
    <xpath>Defs/ThinkTreeDef[defName="HumanlikeConstant"]/thinkRoot/subNodes/li[@Class="ThinkNode_ConditionalCanDoConstantThinkTreeJobNow"]/subNodes/li[@Class="JobGiver_ConfigurableHostilityResponse"]</xpath>
    <value>
      <li Class="SurveillanceShift.JobGiver_ColonistThreatReaction" />
    </value>
  </Operation>

  <Operation Class="PatchOperationInsert">
    <xpath>Defs/ThinkTreeDef[defName="AnimalConstant"]/thinkRoot/subNodes/li[@Class="ThinkNode_ConditionalCanDoConstantThinkTreeJobNow"]/subNodes/li[@Class="JobGiver_AnimalFlee"]</xpath>
    <value>
      <li Class="SurveillanceShift.JobGiver_AnimalThreatReaction" />
    </value>
  </Operation>
</Patch>
