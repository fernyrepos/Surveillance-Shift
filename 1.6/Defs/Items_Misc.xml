	</OrderedTakeGroupDef>

	<ThingDef ParentName="ResourceBase">
		<defName>SS_RemoteSurveillanceDevice</defName>
		<label>remote surveillance tablet</label>
		<researchPrerequisites>
			<li>SS_RemoteSurveillance</li>
		</researchPrerequisites>
		<description>A small touchscreen data streaming tablet with wireless fucntionality. Requires a linked router to permit network surveillance.</description>
		<graphicData>
			<texPath>Things/Item/Special/RemoteSurveillanceDevice</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>1200</MarketValue>
			<MaxHitPoints>60</MaxHitPoints>
			<Mass>0.5</Mass>
			<Flammability>0.5</Flammability>
			<DeteriorationRate>6</DeteriorationRate>
		</statBases>
		<tickerType>Rare</tickerType>
		<techLevel>Industrial</techLevel>
		<stackLimit>1</stackLimit>
		<soundInteract>Standard_Drop</soundInteract>
		<soundDrop>Standard_Drop</soundDrop>
		<thingCategories>
			<li>Manufactured</li>
		</thingCategories>
		<orderedTakeGroup>SS_RemoteSurveillanceDevice</orderedTakeGroup>
		<comps>
			<li Class="SurveillanceShift.CompProperties_RemoteSurveillanceDevice" />
		</comps>
		<tradeability>Sellable</tradeability>
	</ThingDef>

