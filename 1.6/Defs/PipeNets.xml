<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<PipeSystem.PipeNetDef>
		<defName>SS_VideoCableNet</defName>
		<noStorageAlert>false</noStorageAlert>
		<resource>
			<name>video signal</name>
			<unit>sig</unit>
			<color>(80, 160, 240)</color>
		</resource>
		<pipeDefs>
			<li>SS_VideoCable</li>
			<li>SS_HiddenVideoCable</li>
		</pipeDefs>
		<overlayOptions>
			<overlayColor>(80, 160, 240)</overlayColor>
		</overlayOptions>
		<designator>
			<deconstructIconPath>UI/Gizmos/VideoCables_Deconstruct</deconstructIconPath>
			<designationCategoryDef>Security</designationCategoryDef>
		</designator>
	</PipeSystem.PipeNetDef>

	<ThingDef ParentName="BuildingBase" Name="SS_VideoCableBase">
		<defName>SS_VideoCable</defName>
		<label>video cable</label>
		<researchPrerequisites>
			<li>SS_VideoSurveillance</li>
		</researchPrerequisites>
		<description>High-definition cables for transmitting video data between surveillance devices.</description>
		<thingClass>PipeSystem.Building_Pipe</thingClass>
		<drawStyleCategory>Conduits</drawStyleCategory>
		<graphicData>
			<texPath>Things/Building/Linked/VideoCable_Atlas</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<linkType>Basic</linkType>
			<linkFlags>
				<li>Custom8</li>
			</linkFlags>
			<damageData>
				<rect>(0,0,1,1)</rect>
			</damageData>
		</graphicData>
		<uiIconPath>Things/Building/Linked/VideoCables_MenuIcon</uiIconPath>
		<building>
			<ai_chillDestination>false</ai_chillDestination>
			<isInert>true</isInert>
			<isEdifice>false</isEdifice>
			<deconstructible>true</deconstructible>
			<blueprintGraphicData>
				<texPath>Things/Building/Linked/VideoCable_Blueprint_Atlas</texPath>
			</blueprintGraphicData>
			<canLandGravshipOn>true</canLandGravshipOn>
		</building>
		<altitudeLayer>FloorEmplacement</altitudeLayer>
		<passability>Standable</passability>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
		<resourcesFractionWhenDeconstructed>0</resourcesFractionWhenDeconstructed>
		<statBases>
			<MaxHitPoints>80</MaxHitPoints>
			<WorkToBuild>35</WorkToBuild>
			<Flammability>0.5</Flammability>
		</statBases>
		<costList>
			<Steel>1</Steel>
		</costList>
		<comps>
			<li Class="PipeSystem.CompProperties_Resource">
				<pipeNet>SS_VideoCableNet</pipeNet>
			</li>
		</comps>
		<placeWorkers>
			<li>PipeSystem.PlaceWorker_Pipe</li>
		</placeWorkers>
		<rotatable>false</rotatable>
		<selectable>true</selectable>
		<neverMultiSelect>true</neverMultiSelect>
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		<terrainAffordanceNeeded IsNull="True" />
		<designationCategory>Security</designationCategory>
		<constructEffect>ConstructMetal</constructEffect>
		<clearBuildingArea>false</clearBuildingArea>
		<drawerType>MapMeshOnly</drawerType>
		<tickerType>Rare</tickerType>
	</ThingDef>

	<ThingDef ParentName="SS_VideoCableBase">
		<defName>SS_HiddenVideoCable</defName>
		<label>hidden video cable</label>
		<description>Concealed high-definition cables for transmitting video data between surveillance devices. Invisible once built, but costlier than regular video cables.</description>
		<graphicData>
			<texPath>Things/Building/Linked/HiddenVideoCable_Atlas</texPath>
			<color>(0,0,0,0)</color>
			<shaderType>Transparent</shaderType>
			<linkFlags>
				<li>Custom9</li>
			</linkFlags>
		</graphicData>
		<altitudeLayer>Conduits</altitudeLayer>
		<uiIconPath>Things/Building/Linked/HiddenVideoCables_MenuIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<WorkToBuild>280</WorkToBuild>
			<Flammability>0</Flammability>
			<Beauty>0</Beauty>
		</statBases>
		<costList>
			<Steel>2</Steel>
		</costList>
		<constructEffect>ConstructDirt</constructEffect>
		<building>
			<ai_neverTrashThis>true</ai_neverTrashThis>
			<isTargetable>false</isTargetable>
			<expandHomeArea>false</expandHomeArea>
			<canBeDamagedByAttacks>false</canBeDamagedByAttacks>
		</building>
	</ThingDef>
</Defs>
